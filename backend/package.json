  "scripts": {
    "dev": "kill-port 3001 && ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "db:generate": "prisma generate && sed -i 's|import type { Prisma }|import { Prisma }|; s|@prisma/client/runtime/library|@prisma/client/runtime/client|' src/generated/zod/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed:superadmin": "ts-node src/seed/superadmin.ts",
    "db:seed:demo": "ts-node src/seed/demo.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
